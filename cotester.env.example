# CoTester FAZ 3 — job-scoped env (injected by backend at run time; placeholders for local runs)
# Do not commit real secrets.

TEST_ENV=dev

# API base URL (non-secret)
COTESTER_API_BASE_URL=https://api.example.com
BASE_URL=https://api.example.com

# Bearer token credential profile
API_TOKEN=

# Keycloak credential profile
API_KEYCLOAK_URL=https://keycloak.example.com/realms/your-realm
API_TEST_USERNAME=
API_TEST_PASSWORD=
API_TEST_CLIENT_ID=orbitant-ui-client
API_TEST_CLIENT_SECRET=

# HTTP Basic credential profile
API_BASIC_USERNAME=
API_BASIC_PASSWORD=

# API key credential profile
API_KEY_VALUE=
API_KEY_HEADER=X-API-Key
API_KEY_QUERY=
API_KEY_PLACEMENT=header

# Optional: credentials JSON path when env keys are not set individually
# COTESTER_RUNTIME_CREDENTIALS_FILE=/path/to/credentials.env.json
# COTESTER_RUNTIME_DIR=/path/to/job-runtime

# Custom variables from Environment (non-secret)
# COTESTER_VAR_MY_SETTING=value
